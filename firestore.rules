rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.role == 'ADMIN' || request.auth.token.admin == true);
    }

    // User profile document
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }
    
    // Scans: Private to creator and Admin. Public access goes through server /api/report/:token API
    match /scans/{scanId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Privileged writes occur via Firebase Admin SDK on Express server
      allow write: if false;
    }
    
    // Watchdog monitors
    match /watchdogTargets/{targetId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    
    // Watchdog check history
    match /watchdogChecks/{checkId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    
    // Webhook configuration: Private to owner, secrets protected
    match /webhooks/{webhookId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Webhook deliveries
    match /webhookDeliveries/{deliveryId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    
    // Commercial Orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    
    // Aggregated stats: Read allowed, write restricted to Admin SDK
    match /systemStats/{statId} {
      allow read: if true;
      allow write: if false;
    }

    // Security audit logs: Admin read only, server write only
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
