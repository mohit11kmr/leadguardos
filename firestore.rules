rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'ADMIN';
    }

    // User Accounts
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && !request.resource.data.keys().hasAny(['role']) || isAdmin();
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'id']) || isAdmin();
      allow delete: if isAdmin();
    }

    // Scans - User Scoped
    match /scans/{scanId} {
      allow read: if resource == null || resource.data.userId == request.auth.uid || resource.data.isPublic == true || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Watchdog Targets - User Scoped
    match /watchdogTargets/{targetId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Watchdog Checks Logs - Read Only for Target Owner, Server Write Only
    match /watchdogChecks/{checkId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Webhooks Configuration - User Scoped
    match /webhooks/{webhookId} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Monetization Orders - Server Managed / Client Immutable
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Client creation disallowed without server verification; status updates forbidden from client
      allow create: if false;
      allow update, delete: if false;
    }

    // System Stats - Read Only for signed in users, Server write only
    match /systemStats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit Logs - Read Only for Admin, Server write only
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
