# ============================================================
# LeadGuard OS — Environment Variables
# ============================================================

# --- Required: PostgreSQL (production source of truth) ---

# PostgreSQL connection string. Production FAILS to start without it —
# there is NO silent JSON fallback.
DATABASE_URL="postgresql://user:password@host:5432/leadguardos?schema=public"

# --- Required: Application-owned authentication (JWT) ---

# Access-token signing secret (min 32 chars; generate: openssl rand -hex 32)
JWT_SECRET=
# Refresh-token signing secret (separate from JWT_SECRET)
JWT_REFRESH_SECRET=

# --- Required for AI features ---

GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --- Firebase / Firestore (LEGACY — migration source only) ---
# Production no longer requires Firebase. These are used ONLY by
# scripts/migrate-firestore-to-postgres.ts to read legacy data.

# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIRESTORE_DATABASE_ID=

# Google Cloud credentials file (alternative to explicit key)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Payment Providers ---

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay public key for Vite frontend (KEY_ID only — never KEY_SECRET)
VITE_RAZORPAY_KEY_ID=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cashfree (optional)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# --- AI Services ---

# OpenAI (for AI remediation engine)
OPENAI_API_KEY=
OPENAI_REMEDIATION_MODEL=gpt-4o-mini

# --- Notification Providers ---

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@leadguard.ai

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# WhatsApp Business API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Application Config ---

# Server port (default: 3000)
PORT=3000

# LeadGuard mode for Docker: 'api' or 'worker'
# LEADGUARD_MODE=api

# Data directory for local JSON storage (development/test ONLY — never production source of truth)
# LEADGUARD_DATA_DIR=./data

# --- Rate Limiting / Scaling ---

# Optional shared store for multi-instance rate limiting.
# Without REDIS_URL, production uses PostgreSQL-backed counters
# (RateLimitWindow table) — still shared across instances.
REDIS_URL=

# RATE_LIMIT_FAILURE_MODE controls behavior when the shared store is unreachable:
#   fail-closed (production default) = reject requests (protection never degrades)
#   fail-open                        = allow requests + log loudly
# RATE_LIMIT_FAILURE_MODE=fail-closed
