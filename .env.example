# ============================================================
# LeadGuard OS — Environment Variables
# ============================================================

# --- Required ---

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# --- Firebase / Firestore (Required for production) ---

# Firebase project ID
FIREBASE_PROJECT_ID=

# Firebase Admin SDK service account credentials
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firestore database ID (leave empty for default)
FIRESTORE_DATABASE_ID=

# Google Cloud credentials file (alternative to explicit key)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Payment Providers ---

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay public key for Vite frontend (KEY_ID only — never KEY_SECRET)
VITE_RAZORPAY_KEY_ID=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cashfree (optional)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# --- AI Services ---

# OpenAI (for AI remediation engine)
OPENAI_API_KEY=
OPENAI_REMEDIATION_MODEL=gpt-4o-mini

# --- Notification Providers ---

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@leadguard.ai

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# WhatsApp Business API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Application Config ---

# Server port (default: 3000)
PORT=3000

# Storage mode: 'local' for development JSON, 'firestore' for production
# STORAGE_MODE=local

# LeadGuard mode for Docker: 'api' or 'worker'
# LEADGUARD_MODE=api

# Data directory for local JSON storage (development only)
# LEADGUARD_DATA_DIR=./data
